---
import { CATEGORY_LABELS } from '../lib/categories';

interface Props {
  categories: string[];
}
const { categories } = Astro.props;
---

<section id="categorias" class="filters">
  <div class="container tags">
    {categories.map((cat) => (
      <button type="button" data-category={cat}><span>{CATEGORY_LABELS[cat] ?? cat}</span></button>
    ))}
  </div>
</section>

<style>
  .filters {
    padding-top: 32px;
    padding-bottom: 40px;
  }
  .tags {
    position: relative;
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
    row-gap: 44px;
  }
  .tags::before {
    content: '';
    position: absolute;
    left: -3%;
    right: -3%;
    top: -16%;
    bottom: -46%;
    background-image: url("data:image/svg+xml;base64,");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    transform: scaleY(-1);
    opacity: 0.7;
    pointer-events: none;
    z-index: 0;
  }
  button {
    position: relative;
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
    color: var(--text);
    background: none;
    border: none;
    padding: 16px 10px 24px;
    cursor: pointer;
    z-index: 1;
  }
  button span {
    position: relative;
    z-index: 1;
  }
  button::after {
    content: '';
    position: absolute;
    left: -6%;
    right: -10%;
    top: -16%;
    bottom: -46%;
    background-repeat: no-repeat;
    background-size: 100% 100%;
    transform: scaleY(-1) scale(0.94);
    transform-origin: center;
    opacity: 0;
    pointer-events: none;
    z-index: 1;
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  button:hover::after,
  button:focus-visible::after {
    opacity: 1;
    transform: scaleY(-1) scale(1);
  }
  button:nth-of-type(3n + 1)::after {
    background-image: url("data:image/svg+xml;base64,");
  }
  button:nth-of-type(3n + 2)::after {
    background-image: url("data:image/svg+xml;base64,");
  }
  button:nth-of-type(3n + 3)::after {
    background-image: url("data:image/svg+xml;base64,");
  }
</style>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('#categorias button[data-category]');
  buttons.forEach((btn) => {
    const cat = btn.dataset.category;
    if (!cat) return;
    const cards = document.querySelectorAll<HTMLElement>(`.card[data-category="${cat}"]`);
    const activate = () => cards.forEach((c) => c.classList.add('is-active'));
    const deactivate = () => cards.forEach((c) => c.classList.remove('is-active'));
    btn.addEventListener('mouseenter', activate);
    btn.addEventListener('mouseleave', deactivate);
    btn.addEventListener('focus', activate);
    btn.addEventListener('blur', deactivate);
  });
</script>
