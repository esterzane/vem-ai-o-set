---
import { CATEGORY_LABELS } from '../lib/categories';

interface Props {
  categories: string[];
}
const { categories } = Astro.props;
---

<section id="categorias" class="filters">
  <div class="container tags">
    {categories.map((cat) => (
      <button type="button" data-category={cat}><span>{CATEGORY_LABELS[cat] ?? cat}</span></button>
    ))}
  </div>
</section>

<style>
  .filters {
    padding-top: 32px;
    padding-bottom: 40px;
  }
  .tags {
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
    row-gap: 44px;
  }
  button {
    position: relative;
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
    color: var(--text);
    background: none;
    border: none;
    padding: 24px 10px 16px;
    cursor: pointer;
  }
  button span {
    position: relative;
    z-index: 1;
  }
  button::before {
    content: '';
    position: absolute;
    left: -6%;
    right: -10%;
    top: -46%;
    bottom: -16%;
    background-repeat: no-repeat;
    background-size: 100% 100%;
    pointer-events: none;
    z-index: 0;
    transition: transform 0.4s ease, opacity 0.4s ease;
  }
  button:hover::before {
    transform: translateY(-2px) scale(1.03);
  }
  button:nth-of-type(3n + 1)::before {
    background-image: url("data:image/svg+xml;base64,");
  }
  button:nth-of-type(3n + 2)::before {
    background-image: url("data:image/svg+xml;base64,");
  }
  button:nth-of-type(3n + 3)::before {
    background-image: url("data:image/svg+xml;base64,");
  }
</style>
