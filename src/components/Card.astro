---
import { CATEGORY_LABELS } from '../lib/categories';

interface Props {
  slug: string;
  title: string;
  category: string;
  excerpt?: string;
  cover?: string;
}
const { slug, title, category, excerpt, cover } = Astro.props;
---

<a href={`/knowledge/${slug}`} class="card" data-category={category}>
  <div class="cover">
    {cover ? <img src={cover} alt={title} /> : <div class="cover-placeholder"></div>}
  </div>
  <p class="category">{CATEGORY_LABELS[category] ?? category}</p>
  <h3>{title}</h3>
  {excerpt && <p class="excerpt">{excerpt}</p>}
  <span class="more">ler mais →</span>
</a>

<style>
  .card {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    background: rgba(255, 255, 255, 0.32);
    border-radius: 14px;
    padding: 18px;
    box-shadow: 0 1px 2px rgba(60, 80, 110, 0.04);
    transition: transform 0.35s ease, box-shadow 0.35s ease, background 0.35s ease;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml;base64,");
    background-size: 100% 100%;
    pointer-events: none;
    z-index: 0;
    transition: opacity 0.35s ease;
  }
  .card > * {
    position: relative;
    z-index: 1;
  }
  .card:hover,
  .card.is-active {
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.5);
    box-shadow: 0 18px 30px -14px rgba(45, 65, 95, 0.28);
  }
  .card:hover::before,
  .card.is-active::before {
    filter: saturate(1.4) brightness(0.92);
  }
  .cover {
    border-radius: 9px;
    overflow: hidden;
    margin-bottom: 14px;
  }
  img,
  .cover-placeholder {
    width: 100%;
    height: 140px;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .cover-placeholder {
    background: linear-gradient(135deg, rgba(148, 172, 192, 0.35), rgba(214, 191, 156, 0.35));
  }
  .card:hover img,
  .card:hover .cover-placeholder,
  .card.is-active img,
  .card.is-active .cover-placeholder {
    transform: scale(1.05);
  }
  .category {
    font-size: 11.5px;
    color: #5c7794;
    margin: 0 0 6px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  h3 {
    font-size: 17px;
    margin: 0 0 6px;
    transition: color 0.3s ease;
  }
  .card:hover h3,
  .card.is-active h3 {
    color: #16324f;
  }
  .excerpt {
    font-size: 14px;
    color: var(--text-muted);
    margin: 0;
  }
  .more {
    display: inline-block;
    font-size: 13px;
    color: #5c7794;
    margin-top: 10px;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .card:hover .more,
  .card.is-active .more {
    opacity: 1;
    transform: translateX(0);
  }
</style>
