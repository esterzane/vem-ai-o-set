---
const links = [
  { href: '/#sobre', label: 'sobre' },
  { href: '/#conteudo', label: 'conteúdo' },
  { href: '/#categorias', label: 'categorias' },
  { href: '/#contactos', label: 'contactos' },
];
---

<header class="nav">
  <div class="nav-inner">
    <a href="/" class="logo">
      <img src="/logo-mark.png" alt="vem aí o set" />
    </a>
    <nav>
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .nav {
    position: relative;
  }
  .nav::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -34px;
    height: 56px;
    background-image: url("data:image/svg+xml;base64,");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    pointer-events: none;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 16px clamp(24px, 5vw, 64px);
  }
  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .logo img {
    height: 40px;
    width: auto;
    display: block;
  }
  nav {
    display: flex;
    gap: 20px;
  }
  nav a {
    text-decoration: none;
    font-size: 17px;
    color: var(--text-muted);
  }
</style>
