---
---

<section class="newsletter">
  <div class="container">
    <h3>fique por dentro</h3>
    <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="row">
      <input type="email" name="email" required placeholder="o teu email" />
      <button type="submit">inscrever</button>
    </form>
  </div>
</section>

<style>
  .newsletter {
    text-align: center;
    border-top: 1px solid var(--border);
  }
  .row {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-top: 16px;
  }
  input {
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 14px;
    min-width: 220px;
  }
  button {
    padding: 10px 20px;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: white;
    border-radius: 8px;
    cursor: pointer;
    font-size: 14px;
  }
</style>
