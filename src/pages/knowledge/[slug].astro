---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ContributeForm from '../../components/ContributeForm.astro';
import { CATEGORY_LABELS } from '../../lib/categories';

export async function getStaticPaths() {
  const entries = await getCollection('knowledge');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const allEntries = await getCollection('knowledge');
const related = allEntries
  .filter((e) => e.slug !== entry.slug && e.data.category === entry.data.category)
  .slice(0, 2);

const ATMOSPHERE_IMAGES: Record<string, string> = {
  origem: '/origem-atmosphere-source.jpg',
  'Zona da Rebentação V.01': '/origem-ocean.jpg',
};
const atmosphereImage = ATMOSPHERE_IMAGES[entry.data.category];
---

<Base title={entry.data.title} description={entry.data.excerpt}>
  <article class="container question">
    {atmosphereImage && (
      <div class="atmosphere" style={`background-image: url('${atmosphereImage}')`} aria-hidden="true"></div>
    )}
    <p class="category">{CATEGORY_LABELS[entry.data.category] ?? entry.data.category}</p>
    <h1>{entry.data.title}</h1>
    <p class="date">{entry.data.date.toLocaleDateString('pt-PT')}</p>

    <div class="body">
      <Content />
    </div>

    {entry.data.tags.length > 0 && (
      <div class="tags">
        {entry.data.tags.map((tag) => <span>{tag}</span>)}
      </div>
    )}

    {entry.data.openQuestion && (
      <ContributeForm questionSlug={entry.slug} questionTitle={entry.data.title} />
    )}

    {related.length > 0 && (
      <div class="related">
        <p class="related-label">outras perguntas relacionadas</p>
        <div class="related-grid">
          {related.map((r) => (
            <a href={`/knowledge/${r.slug}`}>{r.data.title}</a>
          ))}
        </div>
      </div>
    )}
  </article>
</Base>

<style>
  .question {
    position: relative;
    max-width: 720px;
    padding: 56px 24px;
  }
  .atmosphere {
    position: absolute;
    bottom: -80px;
    left: 50%;
    transform: translateX(-50%);
    width: min(1500px, 100vw);
    height: 620px;
    background-size: cover;
    background-position: center 40%;
    opacity: 0.65;
    mask-image: radial-gradient(ellipse 66% 60% at 50% 48%, black 34%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 66% 60% at 50% 48%, black 34%, transparent 75%);
    pointer-events: none;
    z-index: 0;
  }
  .atmosphere-distant {
    background-position: center 60%;
    opacity: 0.4;
    mask-image: radial-gradient(ellipse 46% 40% at 50% 46%, black 15%, transparent 60%);
    -webkit-mask-image: radial-gradient(ellipse 46% 40% at 50% 46%, black 15%, transparent 60%);
  }
  .category,
  h1,
  .date,
  .body,
  .tags {
    position: relative;
    z-index: 1;
  }
  .category {
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
    margin: 0 0 10px;
  }
  h1 {
    font-size: 34px;
    line-height: 1.3;
    margin: 0 0 10px;
  }
  .date {
    font-size: 13px;
    color: var(--text-muted);
    margin: 0 0 36px;
  }
  .body {
    max-width: 610px;
    margin-bottom: 32px;
    font-size: 19px;
  }
  .body :global(p) {
    line-height: 1.85;
    margin: 0 0 26px;
  }
  .body :global(p:last-child) {
    margin-bottom: 0;
  }
  .tags {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
  }
  .tags span {
    font-size: 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 4px 12px;
    color: var(--text-muted);
  }
  .related-label {
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    margin: 32px 0 12px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .related-grid a {
    display: block;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    font-size: 14px;
    color: var(--text);
  }
</style>
