---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ContributeForm from '../../components/ContributeForm.astro';

export async function getStaticPaths() {
  const entries = await getCollection('knowledge');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const allEntries = await getCollection('knowledge');
const related = allEntries
  .filter((e) => e.slug !== entry.slug && e.data.category === entry.data.category)
  .slice(0, 2);
---

<Base title={entry.data.title} description={entry.data.excerpt}>
  <article class="container question">
    <p class="category">{entry.data.category}</p>
    <h1>{entry.data.title}</h1>
    <p class="date">{entry.data.date.toLocaleDateString('pt-PT')}</p>

    <div class="body">
      <Content />
    </div>

    {entry.data.tags.length > 0 && (
      <div class="tags">
        {entry.data.tags.map((tag) => <span>{tag}</span>)}
      </div>
    )}

    {entry.data.openQuestion && (
      <ContributeForm questionSlug={entry.slug} questionTitle={entry.data.title} />
    )}

    {related.length > 0 && (
      <div class="related">
        <p class="related-label">outras perguntas relacionadas</p>
        <div class="related-grid">
          {related.map((r) => (
            <a href={`/knowledge/${r.slug}`}>{r.data.title}</a>
          ))}
        </div>
      </div>
    )}
  </article>
</Base>

<style>
  .question {
    max-width: 720px;
    padding: 48px 24px;
  }
  .category {
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    margin: 0 0 8px;
  }
  h1 {
    margin: 0 0 8px;
  }
  .date {
    font-size: 13px;
    color: var(--text-muted);
    margin: 0 0 24px;
  }
  .body {
    margin-bottom: 24px;
  }
  .tags {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
  }
  .tags span {
    font-size: 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 4px 12px;
    color: var(--text-muted);
  }
  .related-label {
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    margin: 32px 0 12px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .related-grid a {
    display: block;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    font-size: 14px;
    color: var(--text);
  }
</style>
